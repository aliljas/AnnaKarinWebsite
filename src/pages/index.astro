---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhyWorkWithMe from '../components/WhyWorkWithMe.astro';
import Development from '../components/Development.astro';
import Commitment from '../components/Commitment.astro';
import WaysToWork from '../components/WaysToWork.astro';
import Testimonials from '../components/Testimonials.astro';
import Connect from '../components/Connect.astro';
import Footer from '../components/Footer.astro';
import { SHOW_TESTIMONIALS } from '../content/site';
---

<BaseLayout>
  <Header />

  <main id="main">
    <Hero />
    <WhyWorkWithMe />
    <Development />
    <Commitment />
    <WaysToWork />
    {SHOW_TESTIMONIALS && <Testimonials />}
    <Connect />
  </main>

  <Footer />
</BaseLayout>
