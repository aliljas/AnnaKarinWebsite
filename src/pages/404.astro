---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { notFound, site } from '../content/site';
---

<BaseLayout title={`${notFound.label} | ${site.name}`} noindex>
  <Header base="/" />

  <main id="main" class="not-found">
    <div class="container not-found__inner">
      <p class="caps not-found__label">{notFound.label}</p>
      <h1>{notFound.heading}</h1>
      <p class="not-found__line">{notFound.line}</p>
      <a class="button button--solid" href={notFound.button.href}>{notFound.button.label}</a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-height: 60vh;
    padding-block: var(--section-pad);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .not-found__label::after {
    content: '';
    display: block;
    width: 3rem;
    height: 1px;
    margin: 1.1rem auto 0;
    background: var(--mist);
  }

  h1 {
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h2);
    line-height: 1.1;
  }

  .not-found__line { max-width: 34ch; margin-block: 1rem 2rem; }
</style>
