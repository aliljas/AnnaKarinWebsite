---
import { footer, site } from '../content/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    {/* The legal name sits right beside it, so the logo is decorative here. */}
    <img class="footer__logo" src={site.logo.src} width={site.logo.width} height={site.logo.height} alt="" loading="lazy" />

    <div class="footer__text">
      <p class="footer__name">{footer.legalName}</p>
      {/* Build year as the fallback; the browser corrects it so it never goes stale. */}
      <p class="footer__copy">© <span data-year>{year}</span> {footer.legalName}</p>
      <script is:inline>
        document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = new Date().getFullYear()));
      </script>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    background: var(--cream);
    font-size: var(--text-small);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer__logo { height: 64px; width: auto; }

  .footer__text { display: grid; gap: 0.25rem; }
  .footer__name { font-weight: 500; }
  .footer__copy { color: var(--slate); }

  @media (min-width: 48rem) {
    .footer__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: right;
    }
  }
</style>
