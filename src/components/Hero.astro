---
import { Image } from 'astro:assets';
import { hero } from '../content/site';
---

{/* Who she is, what she believes, what she does, and her face, all on the first screen. */}
<section class="hero" id={hero.id} aria-labelledby="hero-heading">
  <div class="hero__grid container">
    <div class="hero__text">
      {/* Caps over a short mist rule: the lower half of the logo's lockup. */}
      <p class="hero__byline caps">
        <span>{hero.name}<span class="visually-hidden"> · </span></span>
        <span>{hero.title}</span>
      </p>

      <h1 class="hero__headline" id="hero-heading">{hero.headline}</h1>

      <p class="hero__intro">{hero.intro}</p>

      <div class="hero__buttons">
        <a class="button button--solid" href={hero.button.href}>{hero.button.label}</a>
        <a class="button button--outline" href={hero.waysButton.href}>{hero.waysButton.label}</a>
      </div>
    </div>

    <figure class="hero__photo">
      {/* The source is 1280px wide and not sharp enough to show larger than ~640px. */}
      <Image
        src={hero.photo.src}
        alt={hero.photo.alt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 70rem) 476px, (min-width: 56rem) calc(50vw - 84px), min(640px, 90vw)"
        format="webp"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--cream);
    padding-block: clamp(2.5rem, 1.5rem + 4vh, 4.5rem) clamp(3.5rem, 2rem + 5vh, 5.5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero__text { max-width: 36rem; }

  .hero__byline {
    display: flex;
    flex-direction: column;
    row-gap: 0.15em;
  }
  .hero__byline::after {
    content: '';
    width: 3rem;
    height: 1px;
    margin-top: 1.1rem;
    background: var(--mist);
    transform-origin: left;
  }

  .hero__headline {
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.3rem, 1.6rem + 2.6vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums;
    text-wrap: balance;
    color: var(--ink);
  }

  .hero__intro { margin-top: 1.5rem; }

  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .hero__photo { max-width: 640px; }
  .hero__photo img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgb(47 52 55 / 0.08), 0 28px 50px -30px var(--shadow-ink);
  }

  @media (min-width: 56rem) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  /* Stacked: put her photo straight under the headline so it is on the first
     phone screen, then the paragraph and buttons. */
  @media (max-width: 55.99rem) {
    .hero__grid { display: flex; flex-direction: column; align-items: stretch; gap: 0; }
    .hero__text { display: contents; }
    .hero__byline { order: 1; }
    .hero__headline { order: 2; }
    .hero__photo { order: 3; margin-top: 1.75rem; }
    .hero__intro { order: 4; margin-top: 1.75rem; }
    .hero__buttons { order: 5; }
  }

  @media (max-width: 30rem) {
    .hero__buttons { flex-direction: column; }
  }

  /* The one load moment: the text settles in sequence, the rule draws, the photo follows. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__byline { animation: settle 0.8s var(--ease) both; }
    .hero__byline::after { animation: draw 0.8s var(--ease) 0.35s both; }
    .hero__headline { animation: settle 0.9s var(--ease) 0.1s both; }
    .hero__intro { animation: settle 0.9s var(--ease) 0.25s both; }
    .hero__buttons { animation: settle 0.9s var(--ease) 0.35s both; }
    /* Rise without fading: the photo is the largest paint, so it shows immediately. */
    .hero__photo { animation: rise 1.1s var(--ease) both; }
  }

  @keyframes rise {
    from { transform: translateY(12px); }
    to { transform: none; }
  }

  @keyframes settle {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes draw {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>
