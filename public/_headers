# Security response headers for Cloudflare Pages.
# Applied to every route. Docs: https://developers.cloudflare.com/pages/configuration/headers/
/*
  # Force HTTPS for a year, including subdomains (www).
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Stop the browser from guessing (and mis-trusting) a file's content type.
  X-Content-Type-Options: nosniff
  # Don't let the site be embedded in a frame elsewhere (clickjacking).
  X-Frame-Options: DENY
  # Send only the origin (not the full path) as referrer to other sites.
  Referrer-Policy: strict-origin-when-cross-origin
  # This static brochure site needs none of these device features.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  # What the page may load. 'unsafe-inline' is required for Astro's small inline
  # scripts (mobile menu, year, scroll fade); static.cloudflareinsights.com and
  # cloudflareinsights.com are the cookie-free Cloudflare Web Analytics beacon.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
